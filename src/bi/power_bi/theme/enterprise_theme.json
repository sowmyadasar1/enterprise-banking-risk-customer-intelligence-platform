{
    "name": "Enterprise Banking Theme",
    "dataColors": [
        "#118DFF",
        "#12239E",
        "#E66C37",
        "#6B007B",
        "#E044A7",
        "#744EC2",
        "#D9B300",
        "#D64550",
        "#197278",
        "#1AAB40"
    ],
    "background": "#FFFFFF",
    "foreground": "#252423",
    "tableAccent": "#118DFF",
    "good": "#1AAB40",
    "neutral": "#D9B300",
    "bad": "#D64550",
    "visualStyles": {
        "*": {
            "*": {
                "outspacePane": [
                    {
                        "backgroundColor": { "solid": { "color": "#F3F2F1" } },
                        "foregroundColor": { "solid": { "color": "#252423" } }
                    }
                ],
                "title": [
                    {
                        "show": true,
                        "fontColor": { "solid": { "color": "#252423" } },
                        "fontFamily": "Segoe UI SemiBold, wf_segoe-ui_semibold, helvetica, arial, sans-serif",
                        "fontSize": 14,
                        "alignment": "left"
                    }
                ],
                "background": [
                    {
                        "show": true,
                        "color": { "solid": { "color": "#FFFFFF" } },
                        "transparency": 0
                    }
                ],
                "border": [
                    {
                        "show": true,
                        "color": { "solid": { "color": "#E1DFDD" } },
                        "radius": 4
                    }
                ],
                "dropShadow": [
                    {
                        "show": true,
                        "color": { "solid": { "color": "#000000" } },
                        "angle": 90,
                        "blur": 10,
                        "distance": 3,
                        "transparency": 90
                    }
                ]
            }
        },
        "page": {
            "*": {
                "background": [
                    {
                        "color": { "solid": { "color": "#F8F9FA" } },
                        "transparency": 0
                    }
                ]
            }
        },
        "card": {
            "*": {
                "labels": [
                    {
                        "color": { "solid": { "color": "#252423" } },
                        "fontSize": 24,
                        "fontFamily": "Segoe UI Bold, wf_segoe-ui_bold, helvetica, arial, sans-serif"
                    }
                ],
                "categoryAxis": [
                    {
                        "show": true,
                        "color": { "solid": { "color": "#605E5C" } },
                        "fontSize": 12
                    }
                ]
            }
        }
    }
}
